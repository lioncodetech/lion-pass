    "Ela não será armazenada em texto puro nem mostrada automaticamente novamente. Salve-a em um local seguro e separado do dispositivo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will not be stored in plain text or shown automatically again. Save it somewhere secure and separate from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se almacenará en texto plano ni se mostrará automáticamente de nuevo. Guárdela en un lugar seguro y separado del dispositivo."
          }
        }
      }
    },

        }
      }
    },
    "Você pode consultar esta chave novamente em: Lion Pass > Ajustes > Segurança > Chave de recuperação.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view this key again under Lion Pass > Settings > Security > Recovery key."

    "Esta senha aparece em listas locais de senhas muito comprometidas. Troque-a imediatamente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password appears in local lists of heavily compromised passwords. Change it immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta contraseña aparece en listas locales de contraseñas muy comprometidas. Cámbiela inmediatamente."
          }
        }
      }
    },
    "Esta senha é curta. Use pelo menos 12 caracteres e prefira uma senha gerada.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is short. Use at least 12 characters and prefer a generated password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta contraseña es corta. Use al menos 12 caracteres y prefiera una contraseña generada."
          }
        }
      }
    },
    "Esta senha está sendo reutilizada em outra conta. Use uma senha exclusiva.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is reused by another account. Use a unique password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta contraseña se reutiliza en otra cuenta. Use una contraseña exclusiva."
          }
        }
      }
    },

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LionPass.App.MainWindow"
        Title="Lion Pass" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Icon="/Assets/LionPass.png">
  <Grid>
    <Grid x:Name="UnlockView" Background="#232124">
      <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <Grid Width="164" Height="140" HorizontalAlignment="Center">
          <Image Source="/Assets/LionPass.png" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top" />
          <Border x:Name="KeyringBadge" Width="68" Height="44" CornerRadius="22" Background="#121113" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="False">
            <TextBlock Text="Chaveiro" FontSize="12" FontWeight="SemiBold" Foreground="#F04F74" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
        <TextBlock Text="Lion Pass está bloqueado" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="UnlockInstruction" Text="Digite a senha mestra para desbloquear." FontSize="18" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="540" HorizontalAlignment="Center" />
        <TextBox x:Name="MasterPasswordBox" Width="380" Watermark="Digite a senha mestra" PasswordChar="●" KeyDown="MasterPassword_KeyDown" />
        <Button Content="Desbloquear" Width="380" Classes="brand" HorizontalAlignment="Center" Click="Unlock_Click" />
        <Button x:Name="KeyringButton" Content="Usar chaveiro Linux" Classes="link" HorizontalAlignment="Center" Click="Keyring_Click" IsVisible="False" />
        <CheckBox x:Name="RememberInKeyringCheck" Content="Salvar desbloqueio no chaveiro Linux" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
          <Button Content="Criar novo cofre" Classes="link" Click="Create_Click" />
          <Button Content="Importar cofre" Classes="link" Click="ImportVault_Click" />
        </StackPanel>
        <TextBlock x:Name="UnlockStatus" Foreground="#FF7A8A" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
      </StackPanel>
    </Grid>

    <Grid x:Name="VaultView" IsVisible="False" RowDefinitions="Auto,*">
      <Menu Grid.Row="0" Background="#201F27">
        <MenuItem Header="Arquivo">
          <MenuItem Header="Novo item" InputGesture="Ctrl+N" Click="Add_Click" />
          <MenuItem Header="Importar CSV" Click="ImportCsv_Click" />
          <MenuItem Header="Exportar CSV" Click="ExportCsv_Click" />
          <MenuItem Header="Exportar cofre criptografado" Click="ExportVault_Click" />
          <Separator />
          <MenuItem Header="Bloquear" InputGesture="Ctrl+L" Click="Lock_Click" />
          <MenuItem Header="Sair" Click="Quit_Click" />
        </MenuItem>
        <MenuItem Header="Editar">
          <MenuItem Header="Editar item" Click="Edit_Click" />
          <MenuItem Header="Copiar usuário" Click="CopyUsername_Click" />
          <MenuItem Header="Copiar senha" Click="CopyPassword_Click" />
          <MenuItem Header="Copiar site" Click="CopyWebsite_Click" />
          <MenuItem Header="Copiar e-mail" Click="CopyEmail_Click" />
          <MenuItem Header="Abrir site no navegador" Click="OpenWebsite_Click" />
        </MenuItem>
        <MenuItem Header="Visualizar">
          <MenuItem Header="Todos os itens" Click="ShowAll_Click" />
          <MenuItem Header="Favoritos" Click="ShowFavorites_Click" />
          <MenuItem Header="Segurança" Click="ShowSecurity_Click" />
          <MenuItem Header="Lixeira" Click="ShowTrash_Click" />
        </MenuItem>
        <MenuItem Header="Configurações" Click="Settings_Click" />
        <MenuItem Header="Ajuda">
          <MenuItem Header="Sobre o Lion Pass" Click="About_Click" />
        </MenuItem>
      </Menu>

      <Grid Grid.Row="1" ColumnDefinitions="260,330,*">
        <Border Grid.Column="0" Background="#1D1C23" Padding="14">
          <ScrollViewer>
            <StackPanel Spacing="5">
              <TextBlock x:Name="VaultNameText" Text="My Pass" FontSize="24" FontWeight="Bold" Margin="6,4,6,14" />
              <Button Content="Todos os itens" Classes="navigation" Tag="all" Click="Filter_Click" />
              <Button Content="Favoritos" Classes="navigation" Tag="favorites" Click="Filter_Click" />
              <Button Content="Segurança" Classes="navigation" Tag="security" Click="Filter_Click" />
              <Button Content="Lixeira" Classes="navigation" Tag="trash" Click="Filter_Click" />
              <Expander Header="Tipos" IsExpanded="True" Margin="0,12,0,0">
                <StackPanel x:Name="TypesPanel" />
              </Expander>
              <Expander Header="Categorias" IsExpanded="True">
                <StackPanel>
                  <StackPanel x:Name="CategoriesPanel" />
                  <Button Content="Nova categoria" Classes="navigation" Click="AddCategory_Click" />
                </StackPanel>
              </Expander>
              <Separator Margin="0,12" />
              <Button Content="Configurações" Classes="navigation" Click="Settings_Click" />
              <Button Content="Bloquear" Classes="navigation" Click="Lock_Click" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Background="#211F27" Margin="14">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="CollectionTitle" Text="Todos os itens" FontSize="22" FontWeight="Bold" />
              <TextBlock x:Name="ItemCountText" Classes="muted" />
            </StackPanel>
            <Button Grid.Column="1" Content="Novo" Classes="brand" Click="Add_Click" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,130" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Watermark="Pesquisar…" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="SortBox_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="Título" Tag="title" />
              <ComboBoxItem Content="Recentes" Tag="recent" />
              <ComboBoxItem Content="Categoria" Tag="category" />
            </ComboBox>
          </Grid>
          <ListBox x:Name="ItemsList" Grid.Row="2" SelectionChanged="ItemsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="44,*,Auto" Margin="4,7">
                  <Border Width="38" Height="38" CornerRadius="10" Background="#77757D">
                    <TextBlock Text="{Binding DisplayInitial}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Username}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="★" Foreground="#FFD74A" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid Grid.Column="2" Background="#17171D" Margin="30">
          <StackPanel x:Name="EmptyDetail" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="Selecione um item" FontSize="28" FontWeight="Bold" />
          </StackPanel>
          <ScrollViewer x:Name="DetailScroll" IsVisible="False">
            <StackPanel Spacing="16" MaxWidth="760">
              <Border x:Name="CopyConfirmation" IsVisible="False" Background="#253D36" BorderBrush="#54D4BC" BorderThickness="1" CornerRadius="10" Padding="12,8">
                <TextBlock x:Name="CopyConfirmationText" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </Border>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <Border Width="78" Height="78" CornerRadius="14" Background="#77757D" HorizontalAlignment="Center">
                    <TextBlock x:Name="DetailInitial" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" />
                  <TextBlock x:Name="DetailKind" Classes="muted" FontSize="16" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Editar" Margin="8,0" Click="Edit_Click" />
                <Button Grid.Column="2" Content="Favorito" Click="ToggleFavorite_Click" />
              </Grid>
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Credenciais" FontSize="19" FontWeight="Bold" />
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid Grid.ColumnSpan="2" Background="Transparent" ColumnDefinitions="110,*,Auto" Cursor="Hand" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" PointerPressed="UsernameRow_PointerPressed">
                      <TextBlock Text="Usuário" />
                      <TextBlock x:Name="DetailUsername" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="copyHint muted" Text="⧉" Margin="8,0,0,0" IsVisible="False" />
                      <Grid.ContextMenu><ContextMenu><MenuItem Header="Copiar usuário" Click="CopyUsername_Click" /></ContextMenu></Grid.ContextMenu>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="Transparent" ColumnDefinitions="110,*,Auto" Cursor="Hand" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" PointerPressed="PasswordRow_PointerPressed">
                      <TextBlock Text="Senha" />
                      <TextBlock x:Name="DetailPassword" Grid.Column="1" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="copyHint muted" Text="⧉" Margin="8,0,0,0" IsVisible="False" />
                      <Grid.ContextMenu><ContextMenu><MenuItem Header="Mostrar/ocultar senha" Click="ShowPassword_Click" /><MenuItem Header="Copiar senha" Click="CopyPassword_Click" /></ContextMenu></Grid.ContextMenu>
                    </Grid>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="Transparent" ColumnDefinitions="110,*,Auto" Cursor="Hand" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" PointerPressed="WebsiteRow_PointerPressed">
                      <TextBlock Text="Site" />
                      <TextBlock x:Name="DetailWebsite" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="copyHint muted" Text="⌄" Margin="8,0,0,0" IsVisible="False" />
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Abrir site" Click="OpenWebsite_Click" />
                          <MenuItem Header="Copiar site" Click="CopyWebsite_Click" />
                          <Separator />
                          <MenuItem Header="Editar site" Click="Edit_Click" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="E-mail" />
                    <TextBlock x:Name="DetailEmail" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Right">
                      <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copiar e-mail" Click="CopyEmail_Click" /></ContextMenu></TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBlock Grid.Row="4" Text="Modificado" />
                    <TextBlock x:Name="DetailModified" Grid.Row="4" Grid.Column="1" Classes="muted" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Notas" FontWeight="Bold" FontSize="18" />
                  <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
              </Border>
              <Border x:Name="SecurityBorder" Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="SecurityTitle" FontWeight="Bold" FontSize="18" />
                  <TextBlock x:Name="SecurityMessage" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RestoreButton" Content="Restaurar" IsVisible="False" Click="Restore_Click" />
                <Button x:Name="DeleteButton" Content="Mover para a lixeira" Click="Delete_Click" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

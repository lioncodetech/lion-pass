<Application
    x:Class="LionPass.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="LionCyan">#5AD4DE</Color>
        <Color x:Key="LionBlue">#2270D5</Color>
        <Color x:Key="LionPurple">#734AE8</Color>
        <SolidColorBrush x:Key="LionCyanBrush" Color="{StaticResource LionCyan}" />
        <SolidColorBrush x:Key="LionBlueBrush" Color="{StaticResource LionBlue}" />
        <SolidColorBrush x:Key="LionPurpleBrush" Color="{StaticResource LionPurple}" />
        <SolidColorBrush x:Key="LionPanelBrush" Color="#242126" />
        <SolidColorBrush x:Key="LionSelectionBrush" Color="#8B3A91" />
        <SolidColorBrush x:Key="LionIdentityBrush" Color="#77757D" />
        <LinearGradientBrush x:Key="LionGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource LionCyan}" Offset="0" />
            <GradientStop Color="{StaticResource LionBlue}" Offset="0.52" />
            <GradientStop Color="{StaticResource LionPurple}" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button" x:Key="LionPrimaryButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource LionGradient}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Application.Resources>
</Application>

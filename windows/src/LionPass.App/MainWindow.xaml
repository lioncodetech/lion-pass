<Window
    x:Class="LionPass.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lion Pass">

    <Grid Background="#1D1A1E">
        <Grid x:Name="UnlockView">
            <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <Image Source="Assets/LionPass-1024.png" Width="132" Height="132" />
                <TextBlock Text="Lion Pass" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Seu cofre local e protegido" Opacity="0.7" HorizontalAlignment="Center" />
                <PasswordBox x:Name="MasterPassword" Header="Senha mestra" PlaceholderText="Digite sua senha mestra" KeyDown="MasterPassword_KeyDown" />
                <Button x:Name="UnlockButton" Content="Desbloquear" Style="{StaticResource LionPrimaryButton}" HorizontalAlignment="Stretch" Click="Unlock_Click" />
                <Button x:Name="HelloButton" Content="Desbloquear com Windows Hello" HorizontalAlignment="Stretch" Click="Hello_Click" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Content="Criar novo cofre" HorizontalAlignment="Stretch" Click="Create_Click" />
                    <Button Grid.Column="1" Content="Importar .lionvault" HorizontalAlignment="Stretch" Click="Import_Click" />
                </Grid>
                <InfoBar x:Name="UnlockMessage" IsOpen="False" IsClosable="True" Severity="Error" />
                <TextBlock Text="Lion Code Technology" HorizontalAlignment="Center" Opacity="0.55" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#242126" Padding="16,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="Assets/LionPass-1024.png" Width="38" Height="38" />
                    <TextBlock x:Name="VaultTitle" Text="Lion Pass" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Pesquisar..." TextChanged="SearchBox_TextChanged" />
                <CommandBar Grid.Column="3" Background="Transparent" DefaultLabelPosition="Right">
                    <AppBarButton Icon="Add" Label="Novo" Click="Add_Click" />
                    <AppBarButton Icon="Folder" Label="Categoria" Click="Category_Click" />
                    <AppBarButton Icon="OpenFile" Label="Importar CSV" Click="ImportCsv_Click" />
                    <AppBarButton Icon="Document" Label="Exportar CSV" Click="ExportCsv_Click" />
                    <AppBarButton Icon="Save" Label="Exportar" Click="Export_Click" />
                    <AppBarButton Icon="Setting" Label="Ajustes" Click="Settings_Click" />
                    <AppBarButton Icon="Lock" Label="Bloquear" Click="Lock_Click" />
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="210" />
                    <ColumnDefinition Width="360" MinWidth="300" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Background="#211E22" Padding="12">
                    <StackPanel Spacing="6">
                        <NavigationViewItem Content="Todos os itens" Tag="all" Icon="AllApps" Tapped="Filter_Tapped" />
                        <NavigationViewItem Content="Favoritos" Tag="favorites" Icon="Favorite" Tapped="Filter_Tapped" />
                        <NavigationViewItem Content="Segurança" Tag="security" Icon="Important" Tapped="Filter_Tapped" />
                        <NavigationViewItem Content="Lixeira" Tag="trash" Icon="Delete" Tapped="Filter_Tapped" />
                        <Expander Header="Tipos" IsExpanded="True" Margin="0,12,0,0">
                            <StackPanel x:Name="TypesPanel" />
                        </Expander>
                        <Expander Header="Categorias" IsExpanded="True">
                            <StackPanel x:Name="CategoriesPanel" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1" Background="#272328" Padding="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CollectionTitle" Text="Todos os itens" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ItemCount" Opacity="0.6" />
                        </StackPanel>
                        <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="SortBox_SelectionChanged" Width="130">
                            <ComboBoxItem Content="Título" Tag="title" IsSelected="True" />
                            <ComboBoxItem Content="Mais recentes" Tag="recent" />
                            <ComboBoxItem Content="Categoria" Tag="category" />
                        </ComboBox>
                    </Grid>
                    <ListView x:Name="ItemsList" Grid.Row="1" Margin="0,10,0,0" SelectionChanged="ItemsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LionGradient}">
                                        <FontIcon Glyph="&#xE192;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Username}" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="★" Foreground="#FFD84A" FontSize="20" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer Grid.Column="2" Padding="36,24">
                    <StackPanel x:Name="EmptyDetail" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="54" Opacity="0.45" />
                        <TextBlock Text="Selecione um item" FontSize="28" FontWeight="SemiBold" Opacity="0.65" />
                    </StackPanel>
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" MaxWidth="760" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold" />
                                <TextBlock x:Name="DetailKind" Opacity="0.6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Editar" Click="Edit_Click" />
                                <Button x:Name="RestoreButton" Content="Restaurar" Click="Restore_Click" Visibility="Collapsed" />
                                <Button x:Name="DeleteButton" Content="Excluir" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Background="#2B272C" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Credenciais" FontSize="20" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Usuário" /><TextBlock x:Name="DetailUsername" Grid.Column="1" /><Button Grid.Column="2" Content="Copiar" Click="CopyUsername_Click" /></Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Senha" /><PasswordBox x:Name="DetailPassword" Grid.Column="1" IsTabStop="False" /><Button Grid.Column="2" Content="Mostrar" Click="ShowPassword_Click" /><Button Grid.Column="3" Content="Copiar" Click="CopyPassword_Click" /></Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Site" /><TextBlock x:Name="DetailWebsite" Grid.Column="1" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="Copiar" Click="CopyWebsite_Click" /><Button Grid.Column="3" Content="Abrir" Click="OpenWebsite_Click" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Modificado" /><TextBlock x:Name="DetailModified" Grid.Column="1" /></Grid>
                                <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </Border>
                        <InfoBar x:Name="SecurityCard" IsOpen="True" IsClosable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

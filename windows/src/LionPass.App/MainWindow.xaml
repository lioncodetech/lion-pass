<Window
    x:Class="LionPass.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lion Pass">

    <Grid Background="#1D1A1E">
        <Grid x:Name="UnlockView" Background="#232124">
            <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                <Grid Width="154" Height="138" HorizontalAlignment="Center">
                    <Image Source="Assets/LionPass-1024.png" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <Border x:Name="HelloBadge" Width="58" Height="58" CornerRadius="29" Background="#121113" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE928;" FontSize="31" Foreground="#F04F74" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Text="Lion Pass está bloqueado" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="UnlockInstruction" Text="Digite a senha mestra para desbloquear." FontSize="18" Opacity="0.78" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Center" />
                <PasswordBox x:Name="MasterPassword" Width="380" PlaceholderText="Digite a senha mestra" KeyDown="MasterPassword_KeyDown" />
                <Button x:Name="UnlockButton" Content="Desbloquear" Width="380" Background="#7C4385" Foreground="White" HorizontalAlignment="Center" Click="Unlock_Click" />
                <Button x:Name="HelloButton" Content="Usar Windows Hello" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Click="Hello_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                    <Button Content="Criar novo cofre" Background="Transparent" BorderThickness="0" Click="Create_Click" />
                    <Button Content="Importar cofre" Background="Transparent" BorderThickness="0" Click="Import_Click" />
                </StackPanel>
                <InfoBar x:Name="UnlockMessage" Width="520" IsOpen="False" IsClosable="True" Severity="Error" />
                <TextBlock Text="Lion Code Technology" HorizontalAlignment="Center" Opacity="0.45" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#242126" Padding="16,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="Assets/LionPass-1024.png" Width="38" Height="38" />
                    <TextBlock x:Name="VaultTitle" Text="Lion Pass" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Pesquisar..." TextChanged="SearchBox_TextChanged" />
                <CommandBar Grid.Column="3" Background="Transparent" DefaultLabelPosition="Right">
                    <AppBarButton Label="Novo" Click="Add_Click"><AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Categoria" Click="Category_Click"><AppBarButton.Icon><SymbolIcon Symbol="Folder" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Importar CSV" Click="ImportCsv_Click"><AppBarButton.Icon><SymbolIcon Symbol="OpenFile" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Exportar CSV" Click="ExportCsv_Click"><AppBarButton.Icon><SymbolIcon Symbol="Document" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Exportar" Click="Export_Click"><AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Ajustes" Click="Settings_Click"><AppBarButton.Icon><SymbolIcon Symbol="Setting" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Label="Bloquear" Click="Lock_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon></AppBarButton>
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="210" />
                    <ColumnDefinition Width="360" MinWidth="300" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Background="#211E22" Padding="12">
                    <StackPanel Spacing="6">
                        <NavigationViewItem Content="Todos os itens" Tag="all" Tapped="Filter_Tapped"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Favoritos" Tag="favorites" Tapped="Filter_Tapped"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Segurança" Tag="security" Tapped="Filter_Tapped"><NavigationViewItem.Icon><SymbolIcon Symbol="Important" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Lixeira" Tag="trash" Tapped="Filter_Tapped"><NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon></NavigationViewItem>
                        <Expander Header="Tipos" IsExpanded="True" Margin="0,12,0,0">
                            <StackPanel x:Name="TypesPanel" />
                        </Expander>
                        <Expander Header="Categorias" IsExpanded="True">
                            <StackPanel x:Name="CategoriesPanel" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1" Background="#272328" Padding="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CollectionTitle" Text="Todos os itens" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ItemCount" Opacity="0.6" />
                        </StackPanel>
                        <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="SortBox_SelectionChanged" Width="130">
                            <ComboBoxItem Content="Título" Tag="title" IsSelected="True" />
                            <ComboBoxItem Content="Mais recentes" Tag="recent" />
                            <ComboBoxItem Content="Categoria" Tag="category" />
                        </ComboBox>
                    </Grid>
                    <ListView x:Name="ItemsList" Grid.Row="1" Margin="0,10,0,0" SelectionChanged="ItemsList_SelectionChanged">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#8B3A91" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#9846A0" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#76317C" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LionIdentityBrush}">
                                        <TextBlock Text="{Binding DisplayInitial}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Username}" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer Grid.Column="2" Padding="36,24">
                    <Grid>
                        <StackPanel x:Name="EmptyDetail" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE72E;" FontSize="54" Opacity="0.45" />
                            <TextBlock Text="Selecione um item" FontSize="28" FontWeight="SemiBold" Opacity="0.65" />
                        </StackPanel>
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed" MaxWidth="760" Spacing="18">
                            <InfoBar x:Name="CopyConfirmation" IsOpen="False" IsClosable="False" Severity="Success" />
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="78" Height="78" CornerRadius="14" Background="{StaticResource LionIdentityBrush}">
                                        <TextBlock x:Name="DetailInitial" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DetailKind" Opacity="0.6" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Editar" Click="Edit_Click" />
                                    <Button x:Name="RestoreButton" Content="Restaurar" Click="Restore_Click" Visibility="Collapsed" />
                                    <Button x:Name="DeleteButton" Content="Excluir" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#2B272C" CornerRadius="16" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Credenciais" FontSize="20" FontWeight="SemiBold" />
                                    <Grid Background="Transparent" ColumnSpacing="8" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" Tapped="UsernameRow_Tapped" ToolTipService.ToolTip="Clique para copiar o usuário">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Usuário" />
                                        <TextBlock x:Name="DetailUsername" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Tag="CopyHint" Glyph="&#xE8C8;" FontSize="13" Opacity="0.65" Visibility="Collapsed" />
                                        <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copiar usuário" Click="CopyUsername_Click" /></MenuFlyout></Grid.ContextFlyout>
                                    </Grid>
                                    <Grid Background="Transparent" ColumnSpacing="8" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" Tapped="PasswordRow_Tapped" ToolTipService.ToolTip="Clique para copiar a senha">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Senha" />
                                        <PasswordBox x:Name="DetailPassword" Grid.Column="1" IsTabStop="False" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
                                        <FontIcon Grid.Column="2" Tag="CopyHint" Glyph="&#xE8C8;" FontSize="13" Opacity="0.65" Visibility="Collapsed" />
                                        <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Mostrar/ocultar senha" Click="ShowPassword_Click" /><MenuFlyoutItem Text="Copiar senha" Click="CopyPassword_Click" /></MenuFlyout></Grid.ContextFlyout>
                                    </Grid>
                                    <Grid Background="Transparent" ColumnSpacing="8" PointerEntered="CopyableRow_PointerEntered" PointerExited="CopyableRow_PointerExited" Tapped="WebsiteRow_Tapped" ToolTipService.ToolTip="Clique para ver as opções do site">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Site" />
                                        <TextBlock x:Name="DetailWebsite" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Tag="CopyHint" Glyph="&#xE70D;" FontSize="11" Opacity="0.65" Visibility="Collapsed" />
                                        <Grid.ContextFlyout>
                                            <MenuFlyout x:Name="WebsiteFlyout">
                                                <MenuFlyoutItem Text="Abrir site" Click="OpenWebsite_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="World" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copiar site" Click="CopyWebsite_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Editar site" Click="Edit_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                    </Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="E-mail" /><TextBlock x:Name="DetailEmail" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copiar e-mail" Click="CopyEmail_Click" /></MenuFlyout></TextBlock.ContextFlyout>
                                        </TextBlock></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Modificado" /><TextBlock x:Name="DetailModified" Grid.Column="1" HorizontalAlignment="Right" /></Grid>
                                    <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" Opacity="0.75" />
                                </StackPanel>
                            </Border>
                            <InfoBar x:Name="SecurityCard" IsOpen="True" IsClosable="False" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
